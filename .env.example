# Existing MyNaai REST API. Leave unset in local Vite dev to use the proxy.
VITE_API_BASE_URL=https://backend.mynaai.in

# Firebase Web app configuration (Firebase Console > Project settings > Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# Public Razorpay key ID used by Checkout (never put a secret here).
VITE_RAZORPAY_KEY_ID=
